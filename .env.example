# Pick ONE provider for `cairn build` (L3 describe pass) and the demo app's
# /api/copilot route.

# Anthropic (default provider) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq (pass --provider groq to the CLI, or provider: "groq" to
# createCopilotHandler) — comma-separated to round-robin across free-tier
# rate limits. https://console.groq.com/keys
GROQ_API_KEYS=

# Gemini (pass --provider gemini to the CLI, or provider: "gemini" to
# createCopilotHandler) — GEMINI_API_KEYS also accepted, comma-separated,
# for the same round-robin as Groq. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides.
# CAIRN_DESCRIBE_MODEL=claude-opus-5
# CAIRN_RUNTIME_MODEL=claude-opus-5
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional: powers the Copilot widget's mic button (createTranscribeHandler
# in @cairn/sdk/transcribe-server). Unset = mic button doesn't render.
# https://console.deepgram.com/
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-2

# Which provider the demo app's /api/copilot route uses. Defaults to groq
# there since that's what ships configured; set to "anthropic" or "gemini" to switch.
# CAIRN_RUNTIME_PROVIDER=groq
