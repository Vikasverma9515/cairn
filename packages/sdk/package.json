{
  "name": "@cairn/sdk",
  "version": "0.1.0",
  "description": "In-app AI copilot widget + server handlers for Cairn (Next.js today; see the repo ROADMAP.md for other frameworks).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cairn-realtime": "dist/realtime-cli.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.tsx",
    "./server": "./src/server.ts",
    "./dashboard": "./src/dashboard.ts",
    "./dashboard-sqlite": "./src/dashboard-sqlite.ts",
    "./transcribe-server": "./src/transcribe-server.ts",
    "./speak-server": "./src/speak-server.ts",
    "./realtime-server": "./src/realtime-server.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && echo '{\"type\":\"commonjs\"}' > dist/package.json && npm run build:widget",
    "build:widget": "esbuild src/web-component.ts --bundle --minify --format=iife --outfile=dist/cairn-widget.js",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@cairn/core": "^0.1.0",
    "better-sqlite3": "^13.0.3",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.37.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^18.3.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
